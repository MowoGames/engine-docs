	"plugins": [
		{
			"name": "Combat",
			"friendlyName": "Combat, Interaction & RPG",
			"category": "Gameplay",
			"description": "Ranged and melee combat with weapon/item definitions, carry and throw, E-to-interact with focus highlight, inventory, crafting stations, gameplay zones, the utility grid and RPG progression - with their placeable actors, serializers, HUD binding sources and Visual Script statics. Registers everything through the engine modular seams when its module loads.",
			"enabledByDefault": false,
			"path": "Engine/Plugins/Combat/Combat.mplugin"
		},
		{
			"name": "DiscordPlatform",
			"friendlyName": "Discord Platform",
			"category": "Online",
			"description": "Discord Social SDK integration: rich presence and the per-frame callback pump. Registers a presence-only IOnlineService through the engine seam when its module loads; the project's platform.discordEnabled/discordApplicationId settings bring it up.",
			"enabledByDefault": false,
			"path": "Engine/Plugins/DiscordPlatform/DiscordPlatform.mplugin"
		},
		{
			"name": "MowoOnlinePlatform",
			"friendlyName": "Mowo Online Platform",
			"category": "Online",
			"description": "Mowo Online Services through the Mowo Games Launcher (MOS SDK, mos_sdk): Mowo ID identity and token, friends and presence, invites and join requests, achievements, cloud saves of the SaveGames folder and the launcher overlay over the game window. Registers an IOnlineService through the engine seam when its module loads; the project's platform.mowoOnlineEnabled/mowoProductId settings bring it up.",
			"enabledByDefault": false,
			"path": "Engine/Plugins/MowoOnlinePlatform/MowoOnlinePlatform.mplugin"
		},
		{
			"name": "ScanHierarchy",
			"friendlyName": "LiDAR Scan Hierarchy (Embree)",
			"category": "Rendering",
			"description": "Casts LiDAR scanner shots against an Embree bounding-volume hierarchy built from the level's render triangles, with moving bodies and bone capsules re-posed every frame, in parallel across the job system. Without it the scanner traces the Jolt colliders on the game thread. Adds about 6.8 MB of Embree to a packaged game, so it is off unless the project enables it.",
			"enabledByDefault": false,
			"path": "Engine/Plugins/ScanHierarchy/ScanHierarchy.mplugin"
		},
		{
			"name": "SmartProps",
			"friendlyName": "Smart Props (Parametric Assemblies)",
			"category": "World Building",
			"description": "Parametric, non-destructive prop assemblies authored as .mprop assets: typed parameters, weighted variants, expression-driven parts, tagged sockets, placement rules and spline/volume/socket scatter. Instances regenerate deterministically from a seed and never write their parts into the scene until baked. Registers its scene system and .mprop serializer when its module loads.",
			"enabledByDefault": false,
			"path": "Engine/Plugins/SmartProps/SmartProps.mplugin"
		},
		{
			"name": "SteamPlatform",
			"friendlyName": "Steam Platform",
			"category": "Online",
			"description": "Steamworks online-platform integration: identity, SDR P2P transport, lobbies and invites, rich presence, stats/achievements, encrypted session tickets and cloud save files. Registers an IOnlineService through the engine seam when its module loads; the project's platform.steamEnabled/steamAppId settings bring it up.",
			"enabledByDefault": false,
			"path": "Engine/Plugins/SteamPlatform/SteamPlatform.mplugin"
		},
		{
			"name": "Survival",
			"friendlyName": "Survival & Economy (Building, Trade)",
			"category": "Gameplay",
			"description": "Base building (placement/demolish modes with catalog and affordability), the currency/trade economy with shops, their .mbuildable/.mshop assets, the template characters' build-mode input as a registered character extension, and the Visual Script statics surface.",
			"enabledByDefault": false,
			"path": "Engine/Plugins/Survival/Survival.mplugin"
		}
	],
	"templates": [
		{
			"name": "TP_Blank",
			"displayName": "Blank",
			"category": "Blank",
			"subtitle": "Empty level, no code",
			"description": "An empty world with a floor and a sun and no gameplay code wired, for building everything from scratch."
		},
		{
			"name": "TP_Coop",
			"displayName": "Multiplayer Co-op",
			"category": "Games",
			"subtitle": "Listen server, replicated players",
			"description": "A multiplayer starter built on the engine's session layer (FNetSession). One player hosts a listen server (host + player in the same process) and others join over the network; each connection gets its own replicated third-person character in the shared arena."
		},
		{
			"name": "TP_FirstPerson",
			"displayName": "First Person",
			"category": "Games",
			"subtitle": "Camera, input, interaction",
			"description": "A ready-to-play first-person starter: a lit room with collidable props, a carryable crate, an item pickup and a sliding door you open by interacting with it."
		},
		{
			"name": "TP_HorrorCoop",
			"displayName": "Horror Co-op",
			"category": "Games",
			"subtitle": "Flashlights, stalker, checkpoints",
			"description": "A dark co-op starter. Two survivors spawn in a sealed facility lit almost entirely by their own flashlights, walk a corridor between two rooms, and share the space with a slow wandering stalker that can hear them."
		},
		{
			"name": "TP_PhysicsPlayground",
			"displayName": "Physics Playground",
			"category": "Games",
			"subtitle": "Simulated props and a character",
			"description": "A ready-to-play physics sandbox: two stacks of simulated RigidBody crates sitting on a kinematic launch plate, a bouncy ball, a heavy ball, a static ramp and an animated SampleBiped. Press Play (or Simulate) and the dynamic props fall, stack and bounce under the engine's Jolt-backed physics."
		},
		{
			"name": "TP_Shooter",
			"displayName": "Shooter",
			"category": "Games",
			"subtitle": "Weapons, targets, ammo crates",
			"description": "A first-person firing range on the engine's weapon framework: equip a hitscan rifle or a projectile launcher, shoot reactive target dummies, reload from ammo crates, and watch the weapon HUD track it."
		},
		{
			"name": "TP_Simulator",
			"displayName": "Simulator",
			"category": "Games",
			"subtitle": "Shop floor, stock, customers",
			"description": "A shop-floor starter. You stand behind the register in a small supermarket, carry stock off the shelves, and a customer walks the aisles and comes to the counter on the store clock."
		},
		{
			"name": "TP_ThirdPerson",
			"displayName": "Third Person",
			"category": "Games",
			"subtitle": "Character, follow camera, anims",
			"description": "A ready-to-play third-person starter: a lit arena with collidable props, an animated SampleBiped, a one-objective quest and an NPC that walks a daily schedule."
		},
		{
			"name": "TP_TopDown",
			"displayName": "Top-Down",
			"category": "Games",
			"subtitle": "Overhead camera, WASD movement",
			"description": "A ready-to-play top-down starter: a walled arena viewed from a steep follow camera, collidable props, an animated SampleBiped and a shrine you can use."
		}
	],
